---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  headingId: string;
}

const { eyebrow, title, description, headingId } = Astro.props;
---

<header class="section-head">
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={headingId}>{title}</h2>
  {description && <p class="section-desc">{description}</p>}
</header>
