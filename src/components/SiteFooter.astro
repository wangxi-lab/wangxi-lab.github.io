---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-row">
    <p>© 2025{year > 2025 ? `–${year}` : ''} {site.name} / {site.handle}</p>
    <nav class="footer-links" aria-label="页脚">
      <a href="/posts/">文章</a>
      <a href="/#about">关于</a>
      <a href={site.github} target="_blank" rel="noreferrer noopener">GitHub</a>
      <a href={`mailto:${site.email}`}>邮箱</a>
    </nav>
  </div>
</footer>
