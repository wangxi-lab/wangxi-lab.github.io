---
import SiteShell from './SiteShell.astro';
import TocAside from '../components/TocAside.astro';
import { formatDate, site, type PostSummary } from '../data/site';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  date: Date;
  updated?: Date;
  minutes: number;
  tags: string[];
  categories: string[];
  headings: Heading[];
  others: PostSummary[];
}

const { title, description, path, date, updated, minutes, tags, categories, headings, others } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  inLanguage: 'zh-CN',
  author: { '@type': 'Person', name: site.name, url: site.url },
  mainEntityOfPage: new URL(path, Astro.site).toString(),
};
---

<SiteShell
  title={`${title} · ${site.name}`}
  description={description}
  path={path}
  active="writing"
  ogType="article"
  jsonLd={jsonLd}
>
  <main id="main" class="article-wrap">
    <div class="wrap post-layout">
      <article>
        <a class="back" href="/">← 返回首页</a>
        <h1 class="page-title">{title}</h1>
        <p class="article-meta">
          <time datetime={date.toISOString()}>{formatDate(date)}</time>
          {updated && <span>更新于 {formatDate(updated)}</span>}
          <span>约 {minutes} 分钟</span>
          {categories.map((category) => <span>{category}</span>)}
        </p>
        {
          tags.length > 0 && (
            <ul class="tags">
              {tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )
        }
        <p class="excerpt-lead">{description}</p>
        <div class="prose">
          <slot />
        </div>
        {
          others.length > 0 && (
            <div class="next-posts">
              <h2>其他文章</h2>
              <div class="post-list">
                {
                  others.map((post) => (
                    <a class="post-row" href={post.href}>
                      <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
                      <span class="post-main">
                        <span class="post-title">{post.title}</span>
                        <span class="post-excerpt">{post.excerpt}</span>
                      </span>
                      <span class="post-go">阅读</span>
                    </a>
                  ))
                }
              </div>
            </div>
          )
        }
      </article>
      <TocAside headings={headings} />
    </div>
  </main>
</SiteShell>
